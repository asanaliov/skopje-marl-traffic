<?xml version='1.0' encoding='utf-8'?>
<sumoConfiguration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">
    <input>
        <net-file value="../../network/skopje_initial.net.xml.gz" />
        <route-files value="../../demand/scenarios/medium/seed_42.rou.xml" />
        <additional-files value="../../polygons/skopje_initial.poly.xml.gz" />
    </input>
    <time>
        <end value="3600" />
    </time>
    <processing>
        <ignore-route-errors value="false" />
        <tls.actuated.jam-threshold value="30" />
    </processing>
    <routing>
        <device.rerouting.adaptation-steps value="18" />
        <device.rerouting.adaptation-interval value="10" />
    </routing>
    <report>
        <verbose value="true" />
        <duration-log.statistics value="true" />
        <no-step-log value="true" />
    </report>
    <gui_only>
        <gui-settings-file value="../skopje_initial.view.xml" />
    </gui_only>
</sumoConfiguration>